# LowEndTalk Offers -> notify-gateway
# Copy to .env for local runs (never commit .env).

FEED_URL=https://lowendtalk.com/categories/offers/feed.rss

# From the notify-gateway project detail page.
NOTIFY_URL=https://notify.example.com/api/notify
NOTIFY_TOKEN=replace-with-the-project-key

# Comma separated, case-insensitive. Plain text, or /regex/i.
# Leave empty to notify every new offer.
#
# Preset B (default): storage / Black Friday deals
KEYWORDS=storage box,storage vps,hdd,black friday
EXCLUDE_KEYWORDS=wtb,looking for,request

# Preset A (China-optimized lines / Asia):
# KEYWORDS=cn2,9929,cmin2,japan,tokyo,osaka,hong kong,singapore
# EXCLUDE_KEYWORDS=wtb,looking for,request

# title (default) or title,body
MATCH_FIELDS=title

# bootstrap: skip (mark current items as seen) | notify (send current matches)
BOOTSTRAP=skip
INTERVAL_MIN=10
MAX_PER_RUN=10
SOURCE=let-offers
STATE_FILE=state.json

# Optional: email,telegram. Omit to let the gateway project decide.
# GATEWAY_CHANNEL=telegram

# ecloudserv injects PORT; 3000 is only the local fallback.
PORT=3000
REQUEST_TIMEOUT=20

# 1 = print matches, never call the gateway, never touch state.
DRY_RUN=0
