# LowEndTalk Offers -> notify-gateway
# Copy to .env for local runs (never commit .env).
# On ecloudserv this file is generated automatically from the panel's
# "Variables" tab (it is rewritten on every change), so fill it there instead.

FEED_URL=https://lowendtalk.com/categories/offers/feed.rss

# From the notify-gateway project detail page.
NOTIFY_URL=https://notify.example.com/api/notify
NOTIFY_TOKEN=replace-with-the-project-key

# Comma separated, case-insensitive. Plain text, or /regex/i.
# Leave empty to notify every new offer.
#
# Active set: China-optimized lines + low price + KVM.
# On ecloudserv avoid backslashes in regex (the platform doubles them in .env),
# and never use commas inside a pattern.
KEYWORDS=cn2,gia,9929,cmin2,cmi,4837,cuvip,hong kong,japan,tokyo,osaka,singapore,korea,seoul,taiwan,kvm,cheap,budget,low cost,lifetime,/[^0-9][0-9][0-9]?([.][0-9][0-9])?/(year|yr)/i,三网,回程,联通,电信
EXCLUDE_KEYWORDS=wtb,looking for,request,dedicated server,object storage,mac mini,email hosting

# Narrower alternative (lines/Asia only):
# KEYWORDS=cn2,gia,9929,cmin2,cmi,4837,cuvip,japan,tokyo,osaka,hong kong,singapore,taiwan
# EXCLUDE_KEYWORDS=wtb,looking for,request,dedicated server,object storage

# title (default) or title,body
MATCH_FIELDS=title

# bootstrap: skip (mark current items as seen) | notify (send current matches)
BOOTSTRAP=skip
INTERVAL_MIN=10
MAX_PER_RUN=10
SOURCE=let-offers
STATE_FILE=state.json

# Optional: email,telegram. Omit to let the gateway project decide.
# GATEWAY_CHANNEL=telegram

# ecloudserv injects PORT; 3000 is only the local fallback.
PORT=3000
REQUEST_TIMEOUT=20

# 1 = print matches, never call the gateway, never touch state.
DRY_RUN=0
